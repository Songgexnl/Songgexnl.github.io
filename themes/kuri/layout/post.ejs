---
layout: false
---
<!DOCTYPE html>
<html lang="<%= config.language %>">
 <head>
  <meta charset="utf-8" />
  <title><%= page.title %> - <%= config.title %></title>
  <link rel="icon" href="<%= theme.fav %>" />
  <meta http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0" />
  <meta name="keywords" content="<%= config.keywords %>" />
  <meta name="description" content="<%= page.description || config.description %>" />
  <link rel="canonical" href="<%= config.url %>/<%= page.path %>" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/mdui.css" importance="high"/>
  <script src="//cdn.kuri.ink/js/mdui/mdui.min.js" async></script>
  <style>
   @import url("<%= theme.iconfont %>");
   .post-meta { color: #999; font-size: 14px; margin-bottom: 24px; }
   .post-meta a { color: #999; margin-right: 8px; }
   .post-title { margin-bottom: 8px; }
   .back-home { margin-top: 32px; display: inline-block; }
  </style>
 </head>
 <body>
   <%- include("_widget/cover.ejs") %>
  <div class="mdui-drawer-body-left mdui-appbar-with-toolbar mdui-theme-layout-auto mdui-loaded">
   <div id="bg" class="index_bg"></div>
   <div>
    <%- include("_partial/header.ejs") %>
    <div class="mdui-drawer mdui-drawer-close sidebar" id="main-drawer">
     <div class="mdui-list" mdui-collapse="{accordion: true}" style="margin-bottom: 75px;">
      <% for (c in theme.sidebar) { %>
      <div class="mdui-collapse-item">
       <div class="mdui-collapse-item-header mdui-list-item mdui-ripple">
        <i class="mdui-list-item-icon mdui-icon material-icons <%= theme.sidebar_color[c][1] %>"><%= theme.sidebar_color[c][0] %></i>
        <div class="mdui-list-item-content"><%= c %></div>
        <i class="mdui-collapse-item-arrow mdui-icon material-icons">keyboard_arrow_down</i>
       </div>
       <% for (d in theme.sidebar[c]) { %>
         <div class="mdui-collapse-item-body mdui-list">
          <a href="<%= theme.sidebar[c][d][0] %>" target="_blank" mdui-tooltip="{content: '<%= theme.sidebar[c][d][1] %>'}" class="mdui-list-item mdui-ripple"><%= d %></a>
         </div>
         <% } %>
      </div>
      <% } %>
     </div>
    </div>
   </div>

   <div id="container" class="container">
    <div class="card" style="margin-top: 1%;">
     <div id="card-content" class="card-content mdui-typo">
      <h1 class="post-title"><%= page.title %></h1>
      <div class="post-meta">
       <%= date(page.date, 'YYYY-MM-DD') %>
       <% if (page.categories && page.categories.length) { %>
         <% page.categories.each(function(cat){ %>
           &nbsp;/&nbsp;<a href="/categories/<%= cat.slug %>/"><%= cat.name %></a>
         <% }) %>
       <% } %>
       <% if (page.tags && page.tags.length) { %>
         <% page.tags.each(function(tag){ %>
           &nbsp;#<a href="/tags/<%= tag.slug %>/"><%= tag.name %></a>
         <% }) %>
       <% } %>
      </div>
      <%- page.content %>
      <a class="back-home mdui-btn mdui-ripple" href="/"><i class="mdui-icon material-icons">arrow_back</i> 返回首页</a>
     </div>
    </div>
   </div>

   <div id="footer" class="footer">
    <p class="remark">
      <%- theme.remark %><br>
      <%- theme.regist %>
      <%- include("_partial/LICENSE.EJS") %>
    </p>
   </div>
  </div>
 </body>
</html>
