<script>
    // 背景列表：支持图片（jpg/png/webp...）与视频（mp4/webm/ogg/mov）
    let rawList = "<%= theme.background %>".split(',').map(function (s) { return s.trim(); }).filter(Boolean);

    // 降级策略：系统开启“减少动态效果”或浏览器处于“省流”时，自动只保留图片，跳过视频
    let prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let saveData = navigator.connection && navigator.connection.saveData;
    let bgList = rawList.filter(function (url) {
        if (!/\.(mp4|webm|ogg|mov)(\?.*)?$/i.test(url)) return true; // 图片一律保留
        return !(prefersReduced || saveData);                          // 视频在省流/减少动效时剔除
    });

    let currentIndex = 0;

    function isVideo(url) {
        return /\.(mp4|webm|ogg|mov)(\?.*)?$/i.test(url);
    }

    // 预置底层图片（兜底背景）：取列表里第一张图片，始终铺在视频之下
    let firstImg = rawList.find(function (u) { return !isVideo(u); });

    function mountVideo(url) {
        let old = document.getElementById("bg-video");
        if (old) old.remove();
        let v = document.createElement("video");
        v.id = "bg-video";
        v.src = url;
        v.autoplay = true;
        v.muted = true;       // 浏览器要求静音才能自动播放
        v.loop = true;
        v.playsInline = true;
        v.style.cssText = "position:fixed;top:0;left:0;width:100%;height:100%;object-fit:cover;z-index:-1;";
        // 视频加载/播放失败（被拦截、格式不支持、网络错误等）时，自动回落到底层图片
        v.addEventListener("error", function () { v.remove(); });
        document.body.prepend(v);
        // 注意：不清除 #bg 的图片，视频层（z-index:-1）压在其上；视频移除后图片自然露底
    }

    function mountImage(url) {
        let old = document.getElementById("bg-video");
        if (old) old.remove();          // 切回图片时移除视频层
        document.getElementById("bg").style.backgroundImage = "url(" + url + ")";
    }

    function changeBackground() {
        setTimeout(function () {
            if (firstImg) document.getElementById("bg").style.backgroundImage = "url(" + firstImg + ")";
            if (!bgList.length) return;
            let item = bgList[currentIndex];
            currentIndex = (currentIndex + 1) % bgList.length;
            if (isVideo(item)) { mountVideo(item); } else { mountImage(item); }
        }, 1000);
    }

    changeBackground();
    // 多个“有效”背景时每 15 秒轮换；仅一个（如“视频+图片”只交替一次循环）时也无害
    if (bgList.length > 1) {
        setInterval(changeBackground, 15000);
    }
</script>
