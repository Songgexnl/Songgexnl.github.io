<script>
    // 背景列表：支持图片（jpg/png/webp...）与视频（mp4/webm/ogg/mov），
    // 可混合配置、支持远程 URL 或本地路径（本地文件放到 source/images/ 下，用 /images/xxx 引用）
    let bgList = "<%= theme.background %>".split(',').map(function (s) { return s.trim(); }).filter(Boolean);
    let currentIndex = 0;

    function isVideo(url) {
        return /\.(mp4|webm|ogg|mov)(\?.*)?$/i.test(url);
    }

    function mountVideo(url) {
        let old = document.getElementById("bg-video");
        if (old) old.remove();
        let v = document.createElement("video");
        v.id = "bg-video";
        v.src = url;
        v.autoplay = true;
        v.muted = true;      // 浏览器要求静音才能自动播放
        v.loop = true;
        v.playsInline = true;
        v.style.cssText = "position:fixed;top:0;left:0;width:100%;height:100%;object-fit:cover;z-index:-1;";
        document.body.prepend(v);
        document.getElementById("bg").style.backgroundImage = "none";
    }

    function mountImage(url) {
        let old = document.getElementById("bg-video");
        if (old) old.remove();
        document.getElementById("bg").style.backgroundImage = "url(" + url + ")";
    }

    function changeBackground() {
        setTimeout(function () {
            if (!bgList.length) return;
            let item = bgList[currentIndex];
            currentIndex = (currentIndex + 1) % bgList.length;
            if (isVideo(item)) { mountVideo(item); } else { mountImage(item); }
        }, 1000);
    }

    changeBackground();
    // 多个背景时每 15 秒轮换；只有一个（或视频）时轮换无害，会重复加载同一项
    if (bgList.length > 1) {
        setInterval(changeBackground, 15000);
    }
</script>
